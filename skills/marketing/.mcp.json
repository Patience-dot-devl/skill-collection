{
  "mcpServers": {
    "gocrawl": {
      "command": "gocrawl",
      "args": [
        "mcp"
      ]
    },
    "google-analytics": {
      "command": "uvx",
      "args": [
        "analytics-mcp"
      ]
    },
    "search-console": {
      "command": "uvx",
      "args": [
        "mcp-search-console@0.4.1"
      ],
      "env": {
        "GSC_ALLOW_DESTRUCTIVE": "false"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--headless",
        "--isolated",
        "--usageStatistics=false"
      ]
    }
  }
}
